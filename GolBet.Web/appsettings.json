{
  "ConnectionStrings": {
    "DefaultConnection": "TU_CONEXION_SQL_SERVER"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/golbet-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}